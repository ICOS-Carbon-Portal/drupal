<?php

use Drupal\Component\Serialization\Yaml;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * @file
 * Install, update and uninstall functions for the Data Products module.
 */

/**
 * Add keyword and show_deprecated to config
 *
 */
function cp_data_products_update_8001() {

	$module_path = \Drupal::service('extension.list.module')->getPath('cp_data_products');

	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.storage.block_content.field_keyword.yml'));
	if (!FieldStorageConfig::loadByName($yml['entity_type'], $yml['field_name'])) {
		FieldStorageConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.storage.block_content.field_show_deprecated.yml'));
	if (!FieldStorageConfig::loadByName($yml['entity_type'], $yml['field_name'])) {
		FieldStorageConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.field.block_content.data_product_preview.field_keyword.yml'));
	if (!FieldConfig::loadByName($yml['entity_type'], $yml['bundle'], $yml['field_name'])) {
		FieldConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.field.block_content.data_product_preview.field_show_deprecated.yml'));
	if (!FieldConfig::loadByName($yml['entity_type'], $yml['bundle'], $yml['field_name'])) {
		FieldConfig::create($yml)->save();
	}
}

/**
 * Add use_collection and collection_id fields to data_product_preview block.
 */
function cp_data_products_update_8002() {

	$module_path = \Drupal::service('extension.list.module')->getPath('cp_data_products');

	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.storage.block_content.field_use_collection.yml'));
	if (!FieldStorageConfig::loadByName($yml['entity_type'], $yml['field_name'])) {
		FieldStorageConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.storage.block_content.field_collection_id.yml'));
	if (!FieldStorageConfig::loadByName($yml['entity_type'], $yml['field_name'])) {
		FieldStorageConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.field.block_content.data_product_preview.field_use_collection.yml'));
	if (!FieldConfig::loadByName($yml['entity_type'], $yml['bundle'], $yml['field_name'])) {
		FieldConfig::create($yml)->save();
	}
	$yml = Yaml::decode(file_get_contents($module_path . '/config/install/field.field.block_content.data_product_preview.field_collection_id.yml'));
	if (!FieldConfig::loadByName($yml['entity_type'], $yml['bundle'], $yml['field_name'])) {
		FieldConfig::create($yml)->save();
	}

	$field_config = FieldConfig::loadByName('block_content', 'data_product_preview', 'field_use_collection');
	if ($field_config) {
		$field_config->setLabel('Use collection ID instead of data type');
		$field_config->save();
	}

	$form_display = \Drupal::entityTypeManager()
		->getStorage('entity_form_display')
		->load('block_content.data_product_preview.default');
	if ($form_display) {
		$form_display->setComponent('field_use_collection', [
			'weight' => 28,
			'settings' => ['display_label' => TRUE],
			'third_party_settings' => [],
			'type' => 'boolean_checkbox',
			'region' => 'content',
		]);
		$form_display->setComponent('field_collection_id', [
			'weight' => 29,
			'settings' => ['size' => 60, 'placeholder' => ''],
			'third_party_settings' => [],
			'type' => 'string_textfield',
			'region' => 'content',
		]);
		$weights = [
			'field_preview_type'      => 30,
			'field_parameter'         => 31,
			'field_number_of_columns' => 32,
			'field_display_height'    => 33,
			'field_keyword'           => 34,
			'field_show_deprecated'   => 35,
		];
		foreach ($weights as $field_name => $weight) {
			$component = $form_display->getComponent($field_name);
			if ($component) {
				$component['weight'] = $weight;
				$form_display->setComponent($field_name, $component);
			}
		}
		$form_display->save();
	}

	$view_display = \Drupal::entityTypeManager()
		->getStorage('entity_view_display')
		->load('block_content.data_product_preview.default');
	if ($view_display) {
		$view_display->setComponent('field_use_collection', [
			'weight' => -1,
			'label' => 'above',
			'settings' => [
				'format' => 'default',
				'format_custom_false' => '',
				'format_custom_true' => '',
			],
			'third_party_settings' => [],
			'type' => 'boolean',
			'region' => 'content',
		]);
		$view_display->setComponent('field_collection_id', [
			'weight' => -2,
			'label' => 'above',
			'settings' => ['link_to_entity' => FALSE],
			'third_party_settings' => [],
			'type' => 'string',
			'region' => 'content',
		]);
		$view_display->save();
	}
}

/**
 * Make the data type field optional, and remove the use_collection override
 * field in favor of collection ID presence/absence.
 */
function cp_data_products_update_8003() {

	$field_config = FieldConfig::loadByName('block_content', 'data_product_preview', 'field_data_type');
	if ($field_config) {
		$field_config->setRequired(FALSE);
		$field_config->save();
	}

	$form_display = \Drupal::entityTypeManager()
		->getStorage('entity_form_display')
		->load('block_content.data_product_preview.default');
	if ($form_display) {
		$form_display->removeComponent('field_use_collection');
		$form_display->save();
	}

	$view_display = \Drupal::entityTypeManager()
		->getStorage('entity_view_display')
		->load('block_content.data_product_preview.default');
	if ($view_display) {
		$view_display->removeComponent('field_use_collection');
		$view_display->save();
	}

	$field_config = FieldConfig::loadByName('block_content', 'data_product_preview', 'field_use_collection');
	if ($field_config) {
		$field_config->delete();
	}

	$field_storage = FieldStorageConfig::loadByName('block_content', 'field_use_collection');
	if ($field_storage) {
		$field_storage->delete();
	}
}
